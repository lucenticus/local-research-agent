# Copy to .env (gitignored, never commit real keys) and fill in.
#
# Optional: Tavily API — managed web search for agent/research_runner.py.
# Without it, a local SearXNG instance is used instead (docker compose up -d)
# — works without a key, but some of its engines (DuckDuckGo, Brave) get
# blocked by their own providers (CAPTCHA/rate-limit), see README.md.
TAVILY_API_KEY=

# Optional: GitHub personal access token — read-only scopes are enough
# (public_repo/repo:status). Only used if config.GITHUB_MCP_ENABLED = True
# (off by default, see sources/github_mcp.py and README's "MCP integrations").
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional: LangSmith tracing — get a key at smith.langchain.com. Only used
# if config.LANGSMITH_TRACING_ENABLED = True (off by default, see
# providers/tracing.py and README's "Tracing" section).
LANGSMITH_API_KEY=
